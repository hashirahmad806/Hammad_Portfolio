---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Manifesto from '../components/manifesto/Manifesto.astro';
import ProjectSection from '../components/projects/ProjectSection.astro';
import CapabilitiesMatrix from '../components/capabilities/CapabilitiesMatrix.astro';
import LabSection from '../components/lab/LabSection.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import AboutSection from '../components/about/AboutSection.astro';
import ContactLounge from '../components/contact/ContactLounge.astro';
---

<BaseLayout>
