---
import ContactForm from './ContactForm.tsx';
import DoubleBezel from '../ui/DoubleBezel.astro';
import EyebrowTag from '../ui/EyebrowTag.astro';
---

<section id="contact" class="py-24 sm:py-32 px-4 sm:px-6 max-w-7xl mx-auto border-t border-white/[0.06]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <!-- Left Column: Engagement Pitch & Socials -->
    <div class="lg:col-span-5">
      <div class="mb-4">
        <EyebrowTag text="07 // Initiating Connection" variant="live" />
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-5xl text-content-primary tracking-tight mb-6 leading-tight">
        Let's construct something extraordinary.
      </h2>
      <p class="font-sans text-sm text-content-secondary leading-relaxed font-light mb-8">
        Whether you are engineering a high-stakes production platform, building an intelligent agentic pipeline, or seeking a principal full-stack contributor—my line is open.
      </p>

      <div class="space-y-4">
        <div class="p-4 rounded-xl bg-surface-subtle/50 border border-white/[0.06] flex items-center justify-between">
          <span class="font-mono text-xs text-content-secondary">Current Timezone</span>
          <span class="font-mono text-xs text-content-primary font-medium">PKT (UTC +5) · Active</span>
        </div>

        <div class="p-4 rounded-xl bg-surface-subtle/50 border border-white/[0.06] flex items-center justify-between">
          <span class="font-mono text-xs text-content-secondary">Typical Response Window</span>
          <span class="font-mono text-xs text-emerald-400 font-medium">&lt; 24 Hours</span>
        </div>
      </div>

      <!-- Social Channels -->
      <div class="pt-8 mt-8 border-t border-white/[0.08]">
        <span class="block text-[11px] font-mono uppercase tracking-wider text-content-tertiary mb-4">
          Verified Networks
        </span>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://github.com/hammad-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-full font-mono text-xs text-content-secondary hover:text-white bg-surface-subtle border border-white/10 hover:border-white/20 transition-all flex items-center gap-1.5"
          >
            <span>GitHub</span>
            <span class="text-[10px]">↗</span>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-full font-mono text-xs text-content-secondary hover:text-white bg-surface-subtle border border-white/10 hover:border-white/20 transition-all flex items-center gap-1.5"
          >
            <span>LinkedIn</span>
            <span class="text-[10px]">↗</span>
          </a>
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-full font-mono text-xs text-content-secondary hover:text-white bg-surface-subtle border border-white/10 hover:border-white/20 transition-all flex items-center gap-1.5"
          >
            <span>Twitter / X</span>
            <span class="text-[10px]">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Form Enclosure -->
    <div class="lg:col-span-7">
      <DoubleBezel innerClass="p-6 sm:p-8">
        <ContactForm client:idle />
      </DoubleBezel>
    </div>
  </div>
</section>
