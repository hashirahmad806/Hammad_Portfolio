---
import InteractiveSandbox from './InteractiveSandbox.tsx';
import EyebrowTag from '../ui/EyebrowTag.astro';
---

<section id="lab" class="py-24 sm:py-32 px-4 sm:px-6 max-w-7xl mx-auto border-t border-white/[0.06]">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div>
      <div class="mb-4">
        <EyebrowTag text="04 // Interactive Systems Lab" variant="accent" />
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-5xl text-content-primary tracking-tight">
        Live Technical Sandbox
      </h2>
    </div>
    <p class="font-sans text-sm text-content-secondary max-w-md font-light">
      Interact directly with functional micro-prototypes demonstrating agentic DAG orchestration, real-time ML diagnostic inference, and streaming telemetry buffers.
    </p>
  </div>

  <!-- Interactive Terminal Island -->
  <InteractiveSandbox client:visible />
</section>
