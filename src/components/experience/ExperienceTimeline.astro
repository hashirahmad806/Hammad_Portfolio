---
import { experiences } from '../../data/experience';
import DoubleBezel from '../ui/DoubleBezel.astro';
import EyebrowTag from '../ui/EyebrowTag.astro';
---

<section id="experience" class="py-24 sm:py-32 px-4 sm:px-6 max-w-7xl mx-auto border-t border-white/[0.06]">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
    <div>
      <div class="mb-4">
        <EyebrowTag text="05 // Trajectory & Milestones" variant="accent" />
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-5xl text-content-primary tracking-tight">
        Professional Journey
      </h2>
    </div>
    <p class="font-sans text-sm text-content-secondary max-w-md font-light">
      A record of engineering leadership, production software delivery, applied machine learning research, and academic rigor.
    </p>
  </div>

  <div class="relative pl-6 sm:pl-8 border-l border-white/[0.1] space-y-12 max-w-4xl mx-auto">
    {experiences.map((exp, index) => (
      <div class="relative gsap-reveal group">
        <!-- Milestone Node Beacon -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-6 flex items-center justify-center w-5 h-5 rounded-full bg-void border border-accent-electric text-accent-electric text-[9px] font-mono font-bold group-hover:scale-125 group-hover:bg-accent-electric group-hover:text-white transition-all shadow-[0_0_12px_rgba(99,102,241,0.3)]">
          {index + 1}
        </div>

        <DoubleBezel class="transition-all" innerClass="p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-3 border-b border-white/[0.08]">
            <span class="font-mono text-xs text-accent-electric font-semibold">
              {exp.period}
            </span>
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-mono text-content-tertiary">{exp.location}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono tracking-wider uppercase bg-white/[0.05] text-content-secondary border border-white/[0.06]">
                {exp.type}
              </span>
            </div>
          </div>

          <h3 class="font-display font-bold text-xl sm:text-2xl text-content-primary mb-1">
            {exp.role}
          </h3>
          <h4 class="font-sans text-sm text-accent-cyan font-medium mb-4">
            {exp.organization}
          </h4>

          <p class="text-sm font-sans text-content-secondary mb-6 leading-relaxed font-light">
            {exp.description}
          </p>

          <!-- Highlights List -->
          <ul class="space-y-2 mb-6">
            {exp.highlights.map((highlight) => (
              <li class="text-xs text-content-secondary flex items-start gap-2.5">
                <span class="text-accent-telemetry font-mono text-[11px] mt-0.5">▹</span>
                <span class="leading-relaxed">{highlight}</span>
              </li>
            ))}
          </ul>

          <!-- Tech stack chips -->
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/[0.06]">
            {exp.technologies.map((tech) => (
              <span class="px-2 py-0.5 rounded text-[11px] font-mono text-content-tertiary bg-white/[0.03] border border-white/[0.06]">
                {tech}
              </span>
            ))}
          </div>
        </DoubleBezel>
      </div>
    ))}
  </div>
</section>
