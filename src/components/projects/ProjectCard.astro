---
import type { Project } from '../../data/projects';
import DoubleBezel from '../ui/DoubleBezel.astro';
import Button from '../ui/Button.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="gsap-card group" data-category={project.category}>
  <DoubleBezel class="h-full" innerClass="flex flex-col justify-between h-full relative overflow-hidden">
    <!-- Top Bar: Category Pill & Metrics -->
    <div>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-white/[0.08]">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono text-content-tertiary">0{index + 1} //</span>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono tracking-wider uppercase bg-white/[0.05] text-content-secondary border border-white/[0.08]">
            {project.category}
          </span>
        </div>
        <div class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
          {project.metrics}
        </div>
      </div>

      <!-- Title & Tagline -->
      <h3 class="font-display font-bold text-2xl sm:text-3xl text-content-primary mb-3 group-hover:text-white transition-colors">
        {project.title}
      </h3>
      <p class="text-sm font-sans text-content-secondary mb-6 leading-relaxed font-light">
        {project.tagline}
      </p>

      <!-- Problem & Solution Storytelling Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 p-4 rounded-xl bg-surface-subtle/50 border border-white/[0.04]">
        <div>
          <span class="block text-[10px] font-mono uppercase tracking-wider text-rose-400/90 mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Problem
          </span>
          <p class="text-xs text-content-secondary leading-normal">
            {project.problem}
          </p>
        </div>
        <div>
          <span class="block text-[10px] font-mono uppercase tracking-wider text-emerald-400/90 mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Engineered Solution
          </span>
          <p class="text-xs text-content-secondary leading-normal">
            {project.solution}
          </p>
        </div>
      </div>

      <!-- Key Architectural Decisions -->
      <div class="mb-6">
        <span class="block text-[10px] font-mono uppercase tracking-wider text-content-tertiary mb-2.5">
          Key Architectural Decisions
        </span>
        <ul class="space-y-2">
          {project.technicalHighlights.map((highlight) => (
            <li class="text-xs text-content-secondary flex items-start gap-2.5">
              <span class="text-accent-electric font-mono text-[11px] mt-0.5">▹</span>
              <span class="leading-relaxed">{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Tech Stack & Actions -->
    <div class="pt-6 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-4 mt-auto">
      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5">
        {project.stack.map((tech) => (
          <span class="px-2 py-0.5 rounded text-[11px] font-mono text-content-secondary bg-surface-elevated/80 border border-white/[0.06]">
            {tech}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="flex items-center gap-3">
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-content-secondary hover:text-white transition-colors px-3 py-1.5 rounded-full border border-white/10 hover:border-white/20 hover:bg-white/[0.04]"
          aria-label={`View ${project.title} source code on GitHub`}
        >
          <span>GitHub</span>
          <span class="text-[10px]">↗</span>
        </a>
        {project.liveUrl && (
          <a
            href={project.liveUrl}
            class="inline-flex items-center gap-1.5 text-xs font-mono text-void bg-content-primary hover:bg-white font-medium transition-all px-3.5 py-1.5 rounded-full shadow-[0_0_15px_rgba(255,255,255,0.15)]"
            aria-label={`Launch ${project.title} live demo`}
          >
            <span>Live System</span>
            <span class="text-[10px]">↗</span>
          </a>
        )}
      </div>
    </div>
  </DoubleBezel>
</article>
