---
import { projects } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectFilter from './ProjectFilter.tsx';
import EyebrowTag from '../ui/EyebrowTag.astro';

const categories = Array.from(new Set(projects.map((p) => p.category)));
---

<section id="projects" class="py-24 sm:py-32 px-4 sm:px-6 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <div>
      <div class="mb-4">
        <EyebrowTag text="02 // Curated Engineering Works" variant="accent" />
      </div>
      <h2 class="font-display font-bold text-3xl sm:text-5xl text-content-primary tracking-tight">
        Selected Case Studies
      </h2>
    </div>
    <p class="font-sans text-sm text-content-secondary max-w-md font-light">
      Detailed explorations of production-tested full-stack platforms, real-time telemetry architectures, and applied machine learning models.
    </p>
  </div>

  <!-- Interactive Project Filter Island -->
  <ProjectFilter client:visible categories={categories} />

  <!-- Projects Grid -->
  <div id="projects-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {projects.map((project, index) => (
      <ProjectCard project={project} index={index} />
    ))}
  </div>
</section>
